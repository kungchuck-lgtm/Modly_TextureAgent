{
  "name": "Hunyuan3D-Paint Texture",
  "id": "hunyuan-texture",
  "description": "Generates high-quality PBR textures for an existing 3D mesh using a reference image.",
  "version": "1.0.0",
  "author": "Your Name",
  "repository": "https://github.com/kungchuck-lgtm/Modly_TextureAgent",
  "nodes": [
    {
      "id": "input-mesh",
      "type": "input",
      "name": "Input Mesh",
      "dataType": "mesh",
      "required": true
    },
    {
      "id": "input-image",
      "type": "input",
      "name": "Reference Image",
      "dataType": "image",
      "required": true
    },
    {
      "id": "texture-generator",
      "type": "process",
      "name": "Generate Texture",
      "generator_class": "HunyuanTextureGenerator",
      "inputs": [
        { "node": "input-mesh", "param": "mesh_path" },
        { "node": "input-image", "param": "image_path" }
      ],
      "outputs": [
        { "id": "textured-mesh", "type": "output", "name": "Textured Mesh", "dataType": "mesh" }
      ]
    }
  ],
  "variants": [
    {
      "id": "paint-quality",
      "name": "Balanced",
      "vram_gb": 21,
      "parameters": { "max_num_view": 6, "resolution": 512 }
    },
    {
      "id": "paint-ultra",
      "name": "Ultra Quality",
      "vram_gb": 29,
      "parameters": { "max_num_view": 9, "resolution": 768 }
    }
  ]
}
